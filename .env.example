# Gmail SMTP Configuration
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_EMAIL="your_email@gmail.com"
SMTP_PASSWORD="your_16_char_google_app_password"
SMTP_FROM_NAME="INTERNFLOW AI"

